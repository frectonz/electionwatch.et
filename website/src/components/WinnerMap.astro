---
// Where the leading party was beaten, painted through polling stations: the
// station is the finest geography NEBE publishes coordinates for, and
// constituency borders do not exist as open data. Amhara's stations, which
// NEBE published without coordinates, are scattered around their woreda's
// centre and their popups say so.
import { LEADER_COLOR, CHALLENGER_COLOR, NO_RESULT_COLOR } from "@/lib/format";
import { leadingParty, type SeatOutcome } from "@/data/results";

interface Props {
  /** constituency slug -> outcome, per ballot. */
  hopr: Record<string, SeatOutcome>;
  rc: Record<string, SeatOutcome>;
  /** Show only this party's seats in gold, everything else muted. */
  focusParty?: string;
  /** Map data URL (global by default; pass a per-region file for region pages). */
  dataUrl?: string;
  /** Fit the view to the data bounds instead of the default Ethiopia view. */
  fitData?: boolean;
  height?: string;
}
const {
  hopr,
  rc,
  focusParty,
  dataUrl = "/data/polling-stations-map.json",
  fitData = false,
  height = "70vh",
} = Astro.props;

const id = "wmap-" + Math.random().toString(36).slice(2, 8);
const config = {
  sets: { hopr, rc },
  colors: {
    leader: LEADER_COLOR,
    challenger: CHALLENGER_COLOR,
    unknown: NO_RESULT_COLOR,
  },
  leaderName: leadingParty.partyName,
  focusParty: focusParty ?? null,
  dataUrl,
  fitData,
};

// No-result stations dissolve into the base map by design, so a legend swatch
// for them would be invisible; the popup names them instead.
const legend = [
  {
    color: CHALLENGER_COLOR,
    label: focusParty
      ? `Seats held by ${focusParty}`
      : "Held by another party or an independent",
  },
  {
    color: LEADER_COLOR,
    label: focusParty ? "Held by someone else" : "Held by the incumbent",
  },
];
---

<style is:global>
  .wm-pop-status {
    font-size: 13px;
    color: var(--color-ew-text);
    line-height: 1.35;
  }
  .wm-pop-status strong {
    color: var(--color-ew-shell);
  }
  .wm-pop-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    display: inline-block;
    margin-right: 6px;
  }
  .wm-pop-link {
    display: inline-block;
    margin-top: 7px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ew-shell);
    text-decoration: none;
  }
  .wm-pop-link:hover {
    color: var(--color-ew-gold);
  }
  .wm-pop-link:focus:not(:focus-visible) {
    outline: none;
  }
</style>

<div>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-3">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-ew-text-dim">
      {
        legend.map((item) => (
          <li class="inline-flex items-center gap-2">
            <span
              class="w-3 h-3 rounded-full inline-block shrink-0"
              style={`background:${item.color}`}
            />
            {item.label}
          </li>
        ))
      }
    </ul>
    <div
      id={`${id}-mode`}
      class="inline-flex rounded-lg border border-ew-card-border overflow-hidden text-xs shrink-0"
    >
      <button
        data-mode="hopr"
        class="px-3 py-1.5 font-medium bg-ew-shell text-white"
      >
        HoPR
      </button>
      <button
        data-mode="rc"
        class="px-3 py-1.5 font-medium bg-ew-card text-ew-text-dim hover:text-ew-shell"
      >
        Regional Council
      </button>
    </div>
  </div>

  <div class="relative">
    <div
      id={id}
      class="wm-map-root w-full rounded-xl border border-ew-card-border overflow-hidden bg-ew-card"
      style={`height:${height};min-height:360px;`}
      data-config={JSON.stringify(config)}
    >
    </div>
    <div
      id={`${id}-hint`}
      class="absolute inset-0 grid place-items-center pointer-events-none transition-opacity duration-200"
    >
      <span
        class="bg-ew-text/70 text-white text-sm rounded-full px-4 py-2 backdrop-blur-sm"
      >
        Click the map to zoom
      </span>
    </div>
  </div>
</div>

<script>
  import {
    Popup,
    LngLatBounds,
    type ExpressionSpecification,
  } from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import {
    createMap,
    initScrollZoom,
    wireModeToggle,
    wireCursor,
    esc,
    CIRCLE_PAINT_BASE,
    type MapData,
  } from "@/lib/map";

  type Outcome = "leader" | "challenger" | "unknown";
  interface WmConfig {
    sets: { hopr: Record<string, Outcome>; rc: Record<string, Outcome> };
    colors: Record<Outcome, string>;
    leaderName: string;
    focusParty: string | null;
    dataUrl: string;
    fitData: boolean;
  }

  document
    .querySelectorAll<HTMLElement>(".wm-map-root")
    .forEach((container) => {
      const id = container.id;
      const cfg: WmConfig = JSON.parse(container.dataset.config!);
      const map = createMap(id);
      initScrollZoom(map, container, id);

      // The outcome rides on each point as a property, so toggling the ballot
      // repaints 50k features without touching JS.
      const colorExpr = (mode: "hopr" | "rc"): ExpressionSpecification =>
        [
          "match",
          ["get", mode === "hopr" ? "oh" : "or"],
          "challenger",
          cfg.colors.challenger,
          "leader",
          cfg.colors.leader,
          cfg.colors.unknown,
        ] as unknown as ExpressionSpecification;

      async function load() {
        const data = (await fetch(cfg.dataUrl).then((r) =>
          r.json(),
        )) as MapData;
        const points = data.points;
        const { hoprC, rcC } = data;

        const fc: GeoJSON.FeatureCollection = {
          type: "FeatureCollection",
          features: points.map(
            ([
              lat,
              lon,
              regIdx,
              ,
              name,
              woreda,
              hIdx,
              rIdx,
              srcIdx,
            ]): GeoJSON.Feature => {
              const h = hIdx >= 0 ? hoprC[hIdx] : null;
              const r = rIdx >= 0 ? rcC[rIdx] : null;
              return {
                type: "Feature",
                geometry: { type: "Point", coordinates: [lon, lat] },
                properties: {
                  name,
                  woreda: woreda ?? "",
                  region: data.regions[regIdx],
                  oh: (h && cfg.sets.hopr[h.slug]) || "unknown",
                  or: (r && cfg.sets.rc[r.slug]) || "unknown",
                  hslug: h?.slug ?? "",
                  hname: h?.name ?? "",
                  rslug: r?.slug ?? "",
                  rname: r?.name ?? "",
                  derived: srcIdx === 1 ? 1 : 0,
                },
              };
            },
          ),
        };

        if (cfg.fitData && points.length) {
          // Frame the dense core (2nd-98th percentile) so a handful of remote
          // stations don't push the whole region far out.
          const q = (vals: number[], f: number) => {
            const s = [...vals].sort((a, b) => a - b);
            return s[Math.floor(f * (s.length - 1))];
          };
          const lats = points.map((p) => p[0]);
          const lons = points.map((p) => p[1]);
          const bounds = new LngLatBounds(
            [q(lons, 0.02), q(lats, 0.02)],
            [q(lons, 0.98), q(lats, 0.98)],
          );
          map.fitBounds(bounds, { padding: 32, maxZoom: 11, duration: 0 });
        }

        map.addSource("st", { type: "geojson", data: fc });
        map.addLayer({
          id: "st",
          type: "circle",
          source: "st",
          paint: { ...CIRCLE_PAINT_BASE, "circle-color": colorExpr("hopr") },
        });

        let mode: "hopr" | "rc" = "hopr";
        // wireModeToggle appends "-mode" to the id itself.
        wireModeToggle(id, (next) => {
          mode = next as "hopr" | "rc";
          map.setPaintProperty("st", "circle-color", colorExpr(mode));
        });
        wireCursor(map, "st");

        map.on("click", "st", (e) => {
          const f = e.features?.[0];
          if (!f) return;
          const p = f.properties as Record<string, string>;
          const cname = mode === "hopr" ? p.hname : p.rname;
          const cslug = mode === "hopr" ? p.hslug : p.rslug;
          const outcome = (mode === "hopr" ? p.oh : p.or) as Outcome;
          const bodyLabel = mode === "hopr" ? "HoPR" : "Regional Council";

          const where = [p.woreda, p.region]
            .filter(Boolean)
            .map(esc)
            .join(" &middot; ");

          const seat = cname
            ? `The ${bodyLabel} seat here (${esc(cname)})`
            : `The ${bodyLabel} seat here`;
          let status;
          if (outcome === "unknown") {
            status = cname
              ? `No ${bodyLabel} result is published for ${esc(cname)}.`
              : `No ${bodyLabel} constituency is linked to this station.`;
          } else if (outcome === "challenger") {
            status = cfg.focusParty
              ? `${seat} was won by <strong>${esc(cfg.focusParty)}</strong>.`
              : `${seat} went to <strong>another party or an independent</strong>.`;
          } else {
            status = cfg.focusParty
              ? `${seat} was not won by ${esc(cfg.focusParty)}.`
              : `${seat} was won by <strong>${esc(cfg.leaderName)}</strong>.`;
          }
          const dot =
            outcome === "unknown"
              ? ""
              : `<span class="wm-pop-dot" style="background:${cfg.colors[outcome]}"></span>`;
          const link = cslug
            ? `<a class="wm-pop-link" href="/data/candidates/c/${cslug}">See the full result &rsaquo;</a>`
            : "";
          const note = Number(p.derived)
            ? `<div class="ew-pop-note">Placed at random around the centre of ${esc(p.woreda)} woreda because NEBE published no GPS coordinates for this station.</div>`
            : "";

          new Popup({ offset: 12, maxWidth: "300px", closeButton: true })
            .setLngLat(e.lngLat)
            .setHTML(
              `<div>
                <div class="ew-pop-head">
                  <div class="ew-pop-title">${esc(p.name)}</div>
                  ${where ? `<div class="ew-pop-sub">${where}</div>` : ""}
                </div>
                <div class="ew-pop-body">
                  <p class="wm-pop-status">${dot}${status}</p>
                  ${note}
                  ${link}
                </div>
              </div>`,
            )
            .addTo(map);
        });
      }

      map.on("load", load);
    });
</script>
