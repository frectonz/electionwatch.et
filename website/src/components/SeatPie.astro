---
// A council's composition as a donut, next to the table that details it.
import { fmt } from "@/lib/format";

export interface PieSlice {
  name: string;
  value: number;
  color: string;
}

interface Props {
  slices: PieSlice[];
  /** Number shown in the middle of the donut (the decided seats). */
  center: number;
}
const { slices, center } = Astro.props;
const total = slices.reduce((n, s) => n + s.value, 0);
---

<div
  class="seat-pie w-full h-[280px] sm:h-[320px]"
  data-pie={JSON.stringify({ slices, center })}
  role="img"
  aria-label={`${fmt(total)} seats: ${slices
    .map((s) => `${s.name} ${fmt(s.value)}`)
    .join(", ")}`}
>
</div>

<script>
  import * as echarts from "echarts";
  import {
    tooltipBox,
    tipTitle,
    tipRow,
    radial,
    INK,
    MUTED,
    MONO,
  } from "@/scripts/chart-style";

  interface PieConfig {
    slices: { name: string; value: number; color: string }[];
    center: number;
  }

  const nf = (n: number) => n.toLocaleString("en-US");
  const charts: echarts.ECharts[] = [];

  document.querySelectorAll<HTMLElement>(".seat-pie").forEach((el) => {
    const cfg: PieConfig = JSON.parse(el.dataset.pie!);
    const chart = echarts.init(el);
    chart.setOption({
      tooltip: {
        trigger: "item",
        confine: true,
        ...tooltipBox,
        formatter: (p: {
          name: string;
          value: number;
          percent: number;
          marker: string;
        }) =>
          tipTitle(p.name) +
          tipRow("Seats", nf(p.value), p.marker) +
          tipRow("Share", `${p.percent}%`),
      },
      legend: {
        bottom: 0,
        icon: "circle",
        itemWidth: 9,
        itemHeight: 9,
        itemGap: 12,
        textStyle: { color: MUTED, fontSize: 11 },
      },
      graphic: {
        type: "text",
        left: "center",
        top: "42%",
        style: {
          text: nf(cfg.center),
          textAlign: "center",
          textVerticalAlign: "middle",
          fill: INK,
          fontSize: 19,
          fontWeight: 700,
          fontFamily: MONO,
        },
      },
      series: [
        {
          type: "pie",
          radius: ["58%", "82%"],
          center: ["50%", "44%"],
          avoidLabelOverlap: false,
          padAngle: 1.5,
          itemStyle: { borderColor: "#fff", borderWidth: 2, borderRadius: 3 },
          label: { show: false },
          data: cfg.slices.map((s) => ({
            name: s.name,
            value: s.value,
            itemStyle: { color: radial(s.color) },
          })),
        },
      ],
    });
    charts.push(chart);
  });

  if (charts.length) {
    const ro = new ResizeObserver(() => charts.forEach((c) => c.resize()));
    document
      .querySelectorAll<HTMLElement>(".seat-pie")
      .forEach((el) => ro.observe(el));
  }
</script>
